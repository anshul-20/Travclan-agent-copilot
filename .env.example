# Local default is SQLite. Docker compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./data/processed/copilot.db
# auto = use sentence-transformers if installed and model downloadable, else hashed fallback
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LLM is optional. The pipeline works without it. none | openai | anthropic | gemini
LLM_PROVIDER=none
LLM_API_KEY=
REQUIRE_AUTH=false
API_KEY=change-me
DATA_SEED=42
