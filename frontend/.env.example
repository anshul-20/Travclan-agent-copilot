# Copy to .env.local and adjust for your setup
# For local dev, Vite proxies /api → localhost:8000 automatically

# Uncomment and set only when NOT running the Vite dev proxy
# (e.g., for a standalone static build pointing at a deployed API)
# VITE_API_URL=https://your-backend.onrender.com/api
# VITE_API_ROOT=https://your-backend.onrender.com
